<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FrameLayout 실습"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="320dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/ivBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/body" />

                <ImageView
                    android:id="@+id/ivObjDress"
                    android:layout_width="170dp"
                    android:layout_height="130dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="125dp"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/ivObjNecklace"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="120dp"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/ivObjCrown"
                    android:layout_width="50dp"
                    android:layout_height="35dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- 왕관 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.6"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewCrown1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown1" />

                <ImageView
                    android:id="@+id/imageViewCrown2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown2" />
            </LinearLayout>

            <!-- 목걸이 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.6"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewNecklace1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace1" />

                <ImageView
                    android:id="@+id/imageViewNecklace2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace2" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오른쪽: 드레스 선택 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewDress1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress1" />

            <ImageView
                android:id="@+id/imageViewDress2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress2" />

            <ImageView
                android:id="@+id/imageViewDress3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress3" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClickReset"
        android:text="다시하기" />

</LinearLayout>